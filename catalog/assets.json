      "schema_version": "asset-record/3.0",
      "kind": "asset",
      "asset_id": "mdl.skill.business-ops-analysis",
      "slug": "business-ops-analysis",
      "version": "1.0.0",
      "name": { "zh": "经销商经营分析", "en": "Distributor Business Ops Analysis" },
      "summary": {
        "zh": "从出货、回款、费用、库存数据走完「看懂数据 → 定位问题 → 输出汇报」的完整链路。",
        "en": "Turn shipment, receivable, expense and inventory data into a review-ready operating report."
      },
      "description": {
        "zh": "围绕经销商月度/季度经营复盘设计：拆解区域、品类、品牌、渠道结构，核算销售任务完成度与缺口，识别同比环比异常，并产出可直接上经营例会的结论与行动建议。",
        "en": "Designed for monthly and quarterly distributor reviews: break down region, category, brand and channel structure, measure target completion and gaps, detect anomalies, and produce conclusions and actions ready for the management meeting."
      },
      "category": { "primary": "skill/analysis", "labels": ["经营复盘", "数据分析"] },
      "tags": ["经营分析", "经营复盘", "目标达成", "毛利费用"],
      "highlights": ["按出货 / 回款 / 费用 / 净利四层核算", "区域 · 品类 · 渠道结构拆解", "异常波动分级与追赶节奏测算"],
      "examples": [
        { "label": "月度经营复盘", "prompt": "用经营分析技能，基于我上传的 9 月出货、回款、费用和库存表，做一份月度复盘：先给结论，再拆区域和品类，最后列出 3 个可执行的改善动作。" },
        { "label": "目标缺口测算", "prompt": "对比本月目标和实际出货，按区域和品类拆出缺口，测算剩余时间需要怎样的周均出货节奏才能追上。" }
      ],
      "use_cases": [
        { "title": "月度经营例会", "summary": "把四张底表合成一页结论，会议上只讨论缺口与动作。" },
        { "title": "季度目标追赶", "summary": "按区域与品类拆缺口，输出周均追赶节奏。" }
      ],
      "owner": { "org_id": "mdl", "user_id": null },
      "publisher": { "name": "MDL Plugin Market", "verification": "official" },
      "visibility": "public",
      "license": "MIT",
