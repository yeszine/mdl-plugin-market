      "name": { "zh": "可视化图解", "en": "Inline Visuals" },
      "summary": {
        "zh": "在对话里直接画流程图、对比图与结构示意图，讲清业务链路。",
        "en": "Draw flowcharts, comparisons and structure diagrams inside the conversation to explain business processes."
      },
      "description": {
        "zh": "适合解释补货流程、审批链路、库存周转模型、组织分工等结构性问题，把口头描述转成一眼能看懂的图。",
        "en": "For explaining replenishment flows, approval chains, inventory turnover models and org design: turn verbal descriptions into diagrams that are understood at a glance."
      },
      "category": { "primary": "skill/visual", "labels": ["可视化", "流程"] },
      "tags": ["可视化", "流程", "图表", "沟通"],
