    {
      "schema_version": "asset-record/3.0",
      "kind": "asset",
      "asset_id": "mdl.skill.research-guide",
      "slug": "research-guide",
      "version": "1.0.0",
      "name": { "zh": "深度调研", "en": "Deep Research" },
      "summary": {
        "zh": "把模糊问题拆成可检索的子问题，交叉验证后沉淀成带出处的调研结论。",
        "en": "Break a vague question into searchable sub-questions, cross-check the evidence, and deliver cited conclusions."
      },
      "description": {
        "zh": "适用于商圈与竞品调研、品类趋势、渠道政策与厂商动作跟踪。强调先立假设、再找证据、标注置信度，最终输出结构化结论而非资料堆砌。",
        "en": "For market and competitor research, category trends, channel policy and manufacturer moves. Start with hypotheses, gather evidence, label confidence, and deliver structured conclusions instead of a pile of links."
      },
      "category": { "primary": "skill/analysis", "labels": ["调研", "竞品"] },
      "tags": ["调研", "竞品", "商圈", "信息核验"],
      "highlights": ["问题拆解与检索路径设计", "多源交叉验证与置信度标注", "结论先行的结构化交付"],
      "examples": [
        { "label": "竞品动作跟踪", "prompt": "用深度调研技能，梳理本区域三家主要竞品最近一个季度的铺市、促销和价格动作，标注来源与置信度，最后给对我们的影响判断。" },
        { "label": "品类机会扫描", "prompt": "调研这个品类未来 12 个月的增长驱动和风险，按证据强度分层，不要输出没有出处的结论。" }
      ],
      "use_cases": [
        { "title": "竞品季度跟踪", "summary": "把分散信息整理成可对比的动作清单。" },
        { "title": "新品类评估", "summary": "先列假设，再按证据强度给结论。" }
      ],
